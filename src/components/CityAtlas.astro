---
import Scout from './Scout.astro';
import * as staticData from '@/data';
import type { RecordSelectors } from '@/data/selectors';
import { CITY_STATE_LABEL, CITY_STATE_NOTE, CITY_STATE_ORDER } from '@/lib/city';
import { PLATE, formatCoords, graticule, project, scaleBar } from '@/lib/geo';
import { dateParts } from '@/lib/datetime';
import { safeInlineJson } from '@/lib/seo';
import type { AtlasCity } from '@/lib/atlas';
import type { CityState } from '@/data/types';

/**
 * THE ATLAS — geographic discovery.
 *
 * A coordinate field, not a traced outline: every city sits at its true
 * latitude and longitude on a graticule, with a scale bar and a north mark to
 * say so. That is a deliberate choice on three counts —
 *
 *   1. It is honest. Every point is where the city actually is.
 *   2. It sidesteps depicting national boundaries, which is a regulated matter
 *      in India and not something a community site should get wrong.
 *   3. It reads as cartography rather than as a Google Maps clone.
 *
 * What it communicates is community state, and the four states are separated
 * by FORM before colour — a filled station, an open ring, a solid dot, a
 * hairline — so the plate still reads in monochrome. A city is never drawn as
 * an opportunity: there is no "claim this dot".
 *
 * `ghost` is the hero's quiet backdrop; `atlas` is the full instrument.
 */
interface Props {
  variant?: 'atlas' | 'ghost';
  class?: string;
  selectors?: RecordSelectors;
}

const { variant = 'atlas', class: className = '', selectors } = Astro.props;
const data = selectors ?? staticData;
const interactive = variant === 'atlas';

const signals = data.citySignalsRanked();
const grid = graticule(5);
const bar = scaleBar(500);

/** Label side per city, hand-set to stop the north-west cluster colliding. */
const LABEL_LEFT = new Set([
  'chandigarh',
  'jaipur',
  'ahmedabad',
  'indore',
  'mumbai',
  'bengaluru',
  'kochi',
]);

const nodes = signals.map((signal) => {
  const point = project(signal.city.lat, signal.city.lon);
  const left = LABEL_LEFT.has(signal.city.slug);
  return {
    signal,
    point,
    left,
    labelX: left ? point.x - 12 : point.x + 12,
  };
});

// Quiet cities are drawn first so a live station never sits under a label.
const quiet = nodes.filter((n) => n.signal.state === 'discovery');
const lit = nodes.filter((n) => n.signal.state !== 'discovery');

const atlasData: AtlasCity[] = signals.map((s) => ({
  slug: s.city.slug,
  name: s.city.name,
  region: s.city.state,
  state: s.state,
  stateLabel: CITY_STATE_LABEL[s.state],
  note: CITY_STATE_NOTE[s.state],
  coords: formatCoords(s.city.lat, s.city.lon),
  blurb: s.city.blurb,
  events: s.eventCount,
  held: s.heldCount,
  builders: s.builderCount,
  projects: s.projectCount,
  ambassador: s.ambassadors[0]?.name ?? null,
  next: s.next
    ? {
        title: s.next.title,
        date: `${dateParts(s.next.date).dayPadded} ${dateParts(s.next.date).monthDisplay}`,
        slug: s.next.slug,
      }
    : null,
}));

const atlasId = `atlas-${variant}`;

/**
 * Where the scout stands.
 *
 * Both positions are open water, clear of every plotted city and of the
 * plate's own furniture. They differ because the two plates are cropped by
 * different things: the full atlas has its bottom-right corner free, while
 * the hero's copy of it has the proof photograph sitting exactly there.
 */
const scoutAt = variant === 'ghost' ? { x: 115, y: 723 } : { x: 545, y: 596 };

// The readout's resting state is server-rendered, so the panel reads correctly
// with scripts blocked. JS only ever replaces content that is already right.
const resting = atlasData[0];

// Legend counts come from the record. A state with nothing in it still shows,
// at zero — the model is part of what the page is explaining.
const legend = CITY_STATE_ORDER.map((state: CityState) => ({
  state,
  label: CITY_STATE_LABEL[state],
  count: signals.filter((s) => s.state === state).length,
}));
---

<div class:list={['atlas', `is-${variant}`, className]}>
  <div class="atlas-plate">
    <svg
      class="atlas-svg"
      viewBox={`0 0 ${PLATE.width} ${PLATE.height}`}
      role={interactive ? 'group' : 'img'}
      aria-label={interactive
        ? 'Map of Indian cities plotted by coordinate, showing community state'
        : 'A coordinate plot of Indian cities'}
      data-atlas={interactive ? atlasId : undefined}
    >
      <rect
        x="14"
        y="14"
        width={PLATE.width - 28}
        height={PLATE.height - 28}
        class="plate-frame"
        fill="none"></rect>

      <g class="plate-grid" aria-hidden="true">
        {grid.meridians.map((m) => <line x1={m.x} y1="14" x2={m.x} y2={PLATE.height - 14} />)}
        {grid.parallels.map((p) => <line x1="14" y1={p.y} x2={PLATE.width - 14} y2={p.y} />)}
      </g>

      <g class="plate-ticks" aria-hidden="true">
        {
          grid.meridians.map((m) => (
            <text x={m.x} y={PLATE.height - 22} text-anchor="middle">
              {m.lon}°E
            </text>
          ))
        }
        {
          grid.parallels.map((p) => (
            <text x="22" y={p.y - 6}>
              {p.lat}°N
            </text>
          ))
        }
      </g>

      <!-- Cartographic furniture: a real scale, and north, because north is up
           by construction — the projection applies no rotation. -->
      {
        interactive && (
          <g class="plate-furniture" aria-hidden="true">
            <g transform={`translate(${PLATE.width - 40 - bar.width} ${PLATE.height - 52})`}>
              <line x1="0" y1="0" x2={bar.width} y2="0" />
              <line x1="0" y1="-5" x2="0" y2="5" />
              <line x1={bar.width} y1="-5" x2={bar.width} y2="5" />
              <text x={bar.width / 2} y="-11" text-anchor="middle">
                {bar.km} km
              </text>
            </g>
            <g transform="translate(48 62)">
              <path d="M0 -18 L5 4 L0 -1 L-5 4 Z" class="plate-north" />
              <text x="0" y="18" text-anchor="middle">
                N
              </text>
            </g>
          </g>
        )
      }

      {/* The scout: a surveyor standing in open water, clear of every city. */}
      <Scout variant={variant} x={scoutAt.x} y={scoutAt.y} />

      <g class="atlas-nodes">
        {
          quiet.map((n) => {
            const Tag = interactive ? 'a' : 'g';
            return (
              <Tag
                class="node node-discovery"
                href={interactive ? `/cities/${n.signal.city.slug}` : undefined}
                data-node={n.signal.city.slug}
                aria-label={
                  interactive
                    ? `${n.signal.city.name}, ${n.signal.city.state} — ${CITY_STATE_NOTE.discovery}`
                    : undefined
                }
              >
                <circle class="node-hit" cx={n.point.x} cy={n.point.y} r="20" />
                {/* DISCOVERY reacts by being surveyed, not by transmitting:
                    four register ticks step outward and hold. */}
                <g class="node-ticks" transform={`translate(${n.point.x} ${n.point.y})`}>
                  <path d="M0 -7.5v-4M0 7.5v4M-7.5 0h-4M7.5 0h4" />
                </g>
                <circle class="node-dot" cx={n.point.x} cy={n.point.y} r="3.4" />
                <text
                  class="node-label"
                  x={n.labelX}
                  y={n.point.y + 4}
                  text-anchor={n.left ? 'end' : 'start'}
                >
                  {n.signal.city.name}
                </text>
              </Tag>
            );
          })
        }
      </g>

      <g class="atlas-nodes">
        {
          lit.map((n) => {
            const Tag = interactive ? 'a' : 'g';
            const led = n.signal.state === 'ambassador-led';
            return (
              <Tag
                class:list={['node', `node-${n.signal.state}`]}
                href={interactive ? `/cities/${n.signal.city.slug}` : undefined}
                data-node={n.signal.city.slug}
                aria-label={
                  interactive
                    ? `${n.signal.city.name}, ${n.signal.city.state} — ${CITY_STATE_LABEL[n.signal.state]}, ${n.signal.eventCount} events`
                    : undefined
                }
              >
                <circle class="node-hit" cx={n.point.x} cy={n.point.y} r="28" />
                {/* One activation form per state, so the plate still explains
                    itself with the colour taken out. ACTIVE throws a ring;
                    EVENT throws a slower, wider one; INTEREST does not travel
                    at all — it holds a ring at a fixed radius. */}
                {n.signal.state === 'community-interest' ? (
                  <circle class="node-hold" cx={n.point.x} cy={n.point.y} r="11" />
                ) : (
                  <circle
                    class:list={['node-pulse', `node-pulse-${n.signal.state}`]}
                    cx={n.point.x}
                    cy={n.point.y}
                    r={led ? 13 : 6}
                  />
                )}
                {led && (
                  <>
                    <circle class="node-signal" cx={n.point.x} cy={n.point.y} r="14" />
                    <circle
                      class="node-signal node-signal-2"
                      cx={n.point.x}
                      cy={n.point.y}
                      r="14"
                    />
                    <circle class="node-halo" cx={n.point.x} cy={n.point.y} r="13" />
                    {/* The station mark, drawn inline so it scales with the plate. */}
                    <g class="node-mark" transform={`translate(${n.point.x} ${n.point.y})`}>
                      <path d="M0 -11.5V-4.5M0 4.5v7M-11.5 0h7M4.5 0h7" />
                      <path
                        d="M-7.8 -7.8l3.4 3.4M4.4 4.4l3.4 3.4M7.8 -7.8l-3.4 3.4M-4.4 4.4l-3.4 3.4"
                        opacity="0.5"
                      />
                      <circle r="3.4" class="node-mark-core" />
                    </g>
                  </>
                )}
                {!led && <circle class="node-dot" cx={n.point.x} cy={n.point.y} r="5.6" />}
                <text
                  class="node-label node-label-lit"
                  x={led ? n.labelX + 6 : n.labelX}
                  y={n.point.y + 5}
                  text-anchor={n.left ? 'end' : 'start'}
                >
                  {n.signal.city.name}
                </text>
              </Tag>
            );
          })
        }
      </g>
    </svg>

    {
      interactive && (
        <p class="plate-note">
          Positions are true latitude and longitude. No borders are drawn — this is a coordinate
          plot, not a political map.
        </p>
      )
    }
  </div>

  {
    interactive && resting && (
      <div class="atlas-side">
        <div class="readout" data-readout={atlasId} aria-live="polite">
          <p class="label readout-kicker">Selected</p>
          <p class="readout-name" data-readout-name>
            {resting.name}
          </p>
          <p class="readout-region" data-readout-region>
            {resting.region}
          </p>
          <p class="coords" data-readout-coords>
            {resting.coords}
          </p>

          <p
            class:list={['chip', `chip-${resting.state}`, 'readout-chip']}
            data-readout-chip
            data-state={resting.state}
          >
            <span data-readout-state>{resting.stateLabel}</span>
          </p>

          <p class="readout-note" data-readout-note>
            {resting.note}
          </p>

          <dl class="readout-stats" data-readout-stats>
            <div>
              <dt>Events</dt>
              <dd data-readout-events>{String(resting.events).padStart(2, '0')}</dd>
            </div>
            <div>
              <dt>Builders</dt>
              <dd data-readout-builders>{String(resting.builders).padStart(2, '0')}</dd>
            </div>
            <div>
              <dt>Projects</dt>
              <dd data-readout-projects>{String(resting.projects).padStart(2, '0')}</dd>
            </div>
          </dl>

          <p class="readout-next" data-readout-next>
            {resting.next && `Next: ${resting.next.date} — ${resting.next.title}`}
          </p>

          <a class="link-arrow readout-go" data-readout-link href={`/cities/${resting.slug}`}>
            <span data-readout-link-label>{`Open ${resting.name}`}</span>
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>

        {/* The list is the primary control on touch: real rows, real targets,
            and it stays in sync with the plate. Nothing here is hover-only. */}
        <div class="atlas-list-wrap">
          <h3 class="label atlas-list-head">All cities plotted</h3>
          <p class="atlas-list-hint">Tap a city to open it.</p>
          <ul class="atlas-list">
            {signals.map((s) => (
              <li>
                <a
                  class="atlas-row"
                  href={`/cities/${s.city.slug}`}
                  data-node={s.city.slug}
                  data-state={s.state}
                >
                  <span class="atlas-row-key" aria-hidden="true" />
                  <span class="atlas-row-name">{s.city.name}</span>
                  <span class="atlas-row-state">{CITY_STATE_LABEL[s.state]}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="atlas-legend-wrap">
          <h3 class="label atlas-list-head">Key</h3>
          <ul class="atlas-legend">
            {legend.map((item) => (
              <li>
                <span class:list={['legend-key', `legend-key-${item.state}`]} aria-hidden="true" />
                <span class="legend-label">{item.label}</span>
                <span class="legend-count">{String(item.count).padStart(2, '0')}</span>
              </li>
            ))}
          </ul>
        </div>

        <script
          is:inline
          type="application/json"
          data-atlas-data={atlasId}
          set:html={safeInlineJson(atlasData)}
        />
      </div>
    )
  }
</div>

{interactive && <script>import '@/scripts/atlas';</script>}

{/* The ghost plate has no readout to drive, but it still has a scout. */}
<script>
  import '@/scripts/scout';
</script>

<style>
  .atlas {
    position: relative;
    display: grid;
    gap: var(--s-7);
  }

  .atlas-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* --- Frame, graticule, furniture -------------------------------------- */
  .plate-frame {
    stroke: var(--rule-strong);
    stroke-width: 1;
  }

  .plate-grid line {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .plate-ticks text {
    fill: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
  }

  .plate-furniture line {
    stroke: var(--ink-3);
    stroke-width: 1;
  }

  .plate-furniture text {
    fill: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
  }

  .plate-north {
    fill: var(--ink-3);
  }

  .plate-note {
    margin-top: var(--s-4);
    max-width: 46ch;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.7;
    color: var(--ink-3);
  }

  /* --- Nodes ------------------------------------------------------------
     Form carries the meaning; colour only reinforces it. */
  .node {
    cursor: pointer;
    outline: none;
  }

  .node-hit {
    fill: transparent;
  }

  .node-label {
    fill: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.04em;
    transition:
      fill var(--dur-2) var(--ease-out),
      font-size var(--dur-2) var(--ease-out);
  }

  .node-label-lit {
    fill: var(--ink);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* Discovery — a hairline circle. Plotted, and nothing more is claimed. */
  .node-discovery .node-dot {
    fill: none;
    stroke: var(--state-discovery);
    stroke-width: 1.2;
    transition:
      fill var(--dur-2) var(--ease-out),
      stroke var(--dur-2) var(--ease-out);
  }

  /* Event activity — an open ring. */
  .node-event-activity .node-dot {
    fill: none;
    stroke: var(--state-activity);
    stroke-width: 2.2;
  }

  /* Community interest — a small solid dot. */
  .node-community-interest .node-dot {
    fill: var(--state-interest);
    stroke: none;
  }

  /* Ambassador-led — the station mark. */
  .node-mark {
    stroke: var(--state-led);
    stroke-width: 1.7;
    stroke-linecap: round;
    fill: none;
  }

  .node-mark-core {
    fill: var(--state-led);
    stroke: none;
  }

  .node-halo {
    fill: color-mix(in srgb, var(--clay) 14%, transparent);
    stroke: none;
  }

  /* The signal: two rings leaving the station. It is a transmission, not a
     connection — the plate never draws a line to a city where nothing is
     happening, because that line would read as a promise. */
  .node-signal {
    fill: none;
    stroke: var(--clay);
    stroke-width: 1;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .node-signal {
      transform-box: fill-box;
      transform-origin: center;
      animation: signal 4.2s var(--ease-out) infinite;
    }

    .node-signal-2 {
      animation-delay: 1.4s;
    }
  }

  @keyframes signal {
    0% {
      transform: scale(0.5);
      opacity: 0;
    }
    12% {
      opacity: 0.55;
    }
    70%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  /* =====================================================================
     ACTIVATION — what a city does when you arrive at it.

     Hover, keyboard focus and programmatic selection are one state, and the
     four community states answer it with four different *forms*: a thrown
     ring, a slower wider ring, a held ring, four register ticks. Convert the
     plate to greyscale and you can still tell them apart, which is the whole
     rule the atlas is built on.

     Every one of them is a single pass. Nothing here loops.
     ===================================================================== */
  .node-pulse,
  .node-hold {
    fill: none;
    stroke: var(--clay);
    stroke-width: 1.4;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .node-ticks path {
    stroke: var(--state-discovery);
    stroke-width: 1.2;
    stroke-linecap: round;
    fill: none;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
    transform: scale(0.55);
  }

  .node:hover .node-dot,
  .node:focus-visible .node-dot,
  .node.is-selected .node-dot {
    fill: var(--clay);
    stroke: var(--clay);
  }

  /* INTEREST holds. It has registered, and registering is not an event. */
  .node:hover .node-hold,
  .node:focus-visible .node-hold,
  .node.is-selected .node-hold {
    opacity: 0.55;
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
    transform: scale(1);
  }

  /* DISCOVERY is surveyed rather than lit: the ticks step out and stop. */
  .node:hover .node-ticks path,
  .node:focus-visible .node-ticks path,
  .node.is-selected .node-ticks path {
    opacity: 0.8;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .node-hold {
      transform: scale(0.72);
    }

    /* ACTIVE — a short, firm ring off a station that is already transmitting. */
    .node:hover .node-pulse-ambassador-led,
    .node:focus-visible .node-pulse-ambassador-led,
    .node.is-selected .node-pulse-ambassador-led {
      animation: node-throw 720ms var(--ease-out) 1;
    }

    /* EVENT — wider and slower, and it starts from the ring itself. */
    .node:hover .node-pulse-event-activity,
    .node:focus-visible .node-pulse-event-activity,
    .node.is-selected .node-pulse-event-activity {
      /* Deliberately not the same easing as ACTIVE. A station's ring leaves
         fast and is gone; an event's ring is watched all the way out. */
      animation: node-carry 1080ms var(--ease-in-out) 1;
    }
  }

  /* With motion reduced the ring is simply present. Same information, held
     still — the state is never carried by the animation alone. */
  @media (prefers-reduced-motion: reduce) {
    .node:hover .node-pulse,
    .node:focus-visible .node-pulse,
    .node.is-selected .node-pulse {
      opacity: 0.45;
    }
  }

  @keyframes node-throw {
    from {
      transform: scale(0.62);
      opacity: 0.7;
    }
    to {
      transform: scale(1.85);
      opacity: 0;
    }
  }

  @keyframes node-carry {
    from {
      transform: scale(0.9);
      opacity: 0.62;
      stroke-width: 2.2;
    }
    to {
      transform: scale(3.4);
      opacity: 0;
      stroke-width: 0.9;
    }
  }

  /* The label is the readout's first line, so it steps forward too — up a
     size, into full ink, and stroked in paper so it lifts off the graticule
     instead of tangling with it. */
  .node:hover .node-label,
  .node:focus-visible .node-label,
  .node.is-selected .node-label {
    fill: var(--ink);
    font-weight: 500;
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 3.5px;
    stroke-linejoin: round;
  }

  .node:hover .node-label {
    font-size: 15.5px;
  }

  .node:hover .node-label-lit,
  .node.is-selected .node-label-lit {
    font-size: 18.5px;
  }

  .node:focus-visible .node-dot,
  .node:focus-visible .node-mark-core {
    stroke: var(--ink);
    stroke-width: 2.5;
  }

  .node:focus-visible .node-label {
    fill: var(--ink);
    font-weight: 500;
  }

  /* --- Readout ---------------------------------------------------------- */
  .atlas-side {
    display: grid;
    gap: var(--s-6);
    align-content: start;
  }

  .readout {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--s-5);
    border: var(--border-hair) solid var(--rule);
    border-left: 2px solid var(--clay);
    background: var(--paper-raised);
  }

  .readout-kicker {
    color: var(--ink-3);
  }

  .readout-name {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 2.6vw, 2.2rem);
    font-weight: 600;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .readout-region {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .readout-chip {
    justify-self: start;
    margin-top: var(--s-3);
  }

  .readout-note {
    margin-top: var(--s-2);
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .readout-stats {
    display: flex;
    gap: var(--s-5);
