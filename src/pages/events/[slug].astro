---
import { privateCache, publicCache } from '@/server/http/cache';
import { eventProjects } from '@/server/public/pages';
import { logReadFailure } from '@/server/public/read-failure';
import ProjectRow from '@/components/directory/ProjectRow.astro';
import { directoryHref } from '@/server/public/projects';
import '@/styles/directory.css';
import { loadLiveRecords } from '@/server/directory';
import { RecordSelectors } from '@/data/selectors';
export const prerender = false;
const _rs = await loadLiveRecords();
const selectors = new RecordSelectors(_rs);

publicCache(Astro);

import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import { site } from '@/data';
import {
  dateParts,
  formatDate,
  formatTime,
  formatTimeRange,
  isoDateTime,
  relativeDay,
  istInstant,
  formatDateLong,
} from '@/lib/datetime';
import { registrationLink } from '@/lib/attribution';
import { CREDIT_ROLE_LABEL } from '@/lib/credits';
import { formatCoords } from '@/lib/geo';
import { asset, requireAsset } from '@/lib/images';
import { titles, trail } from '@/lib/seo';
import {
  formatName,
  isRegistrationOpen,
  lifecycleLabel,
  lifecycleOf,
  lifecycleTone,
} from '@/lib/status';

const { slug } = Astro.params;
if (!slug) return Astro.rewrite('/not-found/');

const event = selectors.eventBySlug.get(slug);
if (!event) return Astro.rewrite('/not-found/');

const lifecycle = lifecycleOf(event);
const parts = dateParts(event.date);
const city = selectors.cityBySlug.get(event.citySlug);
const speakers = selectors.speakersOf(event);
const coHosts = selectors.coHostsOf(event);
const ambassador = selectors.hostAmbassador(event);

/**
 * The credited ambassadors other than the headline host.
 *
 * `primary_host` is excluded because it is `ambassador` above and printing it
 * twice would read as two hosts. `speaker` is excluded because the page
 * already has a speakers block sourced from `event_speakers` — the curated
 * archive's record of who talked — and listing the same person under both
 * would imply two separate contributions.
 */
const otherCredits = selectors.eventCredits(event).filter(
  (entry) => entry.credit.role !== 'primary_host' && entry.credit.role !== 'speaker',
);
const canRegister = isRegistrationOpen(event);
/**
 * The registration href, with WITH CLAUDE attribution merged in. §26.
 *
 * The undecorated `event.registrationUrl` is still what goes into the JSON-LD
 * below — see `registrationLink()` for why a structured-data offer URL should
 * stay canonical.
 */
const registerHref = registrationLink(event.registrationUrl);
const cover = asset(event.coverImage);
/**
 * The URL to publish as this page's `og:image`.
 *
 * `event.coverImage` is a data-layer KEY, not a URL: `covers/cover-vol01.jpg`,
 * resolved against `src/assets/` by `asset()`. Passing the key itself to
 * `Base` — which this page did — had the layout turn it into
 * `https://www.withclaude.in/covers/cover-vol01.jpg` via `new URL(image,
 * site.url)`. The site has never served that path, so the eight events WITH a
 * cover advertised a 404 to every link unfurler while the nine without one
 * fell back to `/og-card.jpg` and worked.
 *
 * `cover.src` is the URL the image pipeline actually emits, so this declares
 * the same picture the page draws rather than a second, invented path. The
 * alternative was to `git mv` the covers into `public/` and declare a
 * root-relative path; the asset route is taken because it keeps content
 * hashing (a corrected picture is a NEW url, which is the only thing that
 * dislodges a card an unfurler has already cached) and because `/_astro/*` is
 * already served `immutable` by `vercel.json`, so it needs no deploy change.
 *
 * `undefined` for an event with no cover, which lets `Base`'s own
 * `/og-card.jpg` default apply — a generic card, never a broken one.
 */
const shareImage = cover?.src;
/**
 * Projects built here: the SAME query and visibility predicate as the
 * Project Directory (`publicProjectsForEvent`), joined on this event's UUID —
 * so the event page, its directory filter and every project's "Built at"
 * badge can never disagree about which projects, or how many.
 */
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
let projectsFailed = false;
const built = UUID.test(event.id)
  ? await eventProjects(event.id, 12).catch((error: unknown) => {
      // Unknown is not "none": the empty-room invitation below must not claim
      // there are no projects when we simply could not read them. The event
      // itself rendered, so this stays a 200 — but one the CDN never stores
      // (and still indexable): the next request should try again.
      logReadFailure('event-projects', error);
      privateCache(Astro, false);
      projectsFailed = true;
      return { items: [], total: 0 };
    })
  : { items: [], total: 0 };
const outputs = built.items;
const recaps = selectors.storiesForEvent(event.slug);
const isPast = lifecycle === 'past';

// An event with neither a cover nor photographs should not leave half the page
// empty — the record simply runs full width.
const hasAside = Boolean(cover || event.photos?.length);

const position = selectors.eventsChronological.findIndex((e) => e.slug === event.slug);
const previous = selectors.eventsChronological[position - 1];
const upNext = selectors.eventsChronological[position + 1];

const metaDescription = lifecycle === 'upcoming' && canRegister && event.registrationUrl
  ? `Register for ${event.title}: ${event.description ?? event.summary}`
  : (event.description ?? event.summary);

const schema = [
  {
    '@type': 'Event',
    name: `${event.title} · ${selectors.cityName(event.citySlug)}`,
    description: event.description ?? event.summary,
    url: `${site.url}/events/${event.slug}`,
    startDate: isoDateTime(event.date, event.startTime),
    ...(event.endTime ? { endDate: isoDateTime(event.date, event.endTime) } : {}),
    eventStatus:
      lifecycle === 'cancelled'
        ? 'https://schema.org/EventCancelled'
        : event.rescheduledFrom
          ? 'https://schema.org/EventRescheduled'
          : 'https://schema.org/EventScheduled',
    // schema.org's own field for a moved event: the date it was announced for.
    ...(event.rescheduledFrom ? { previousStartDate: event.rescheduledFrom } : {}),
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    isAccessibleForFree: event.free,
    location: {
      '@type': 'Place',
      name: event.venue.name,
      address: {
        '@type': 'PostalAddress',
        addressLocality: selectors.cityName(event.citySlug),
        addressCountry: 'IN',
      },
    },
    ...(event.registrationUrl
      ? {
          offers: {
            '@type': 'Offer',
            price: event.free ? '0' : undefined,
            priceCurrency: 'INR',
            url: event.registrationUrl,
            availability:
              lifecycle === 'sold-out'
                ? 'https://schema.org/SoldOut'
                : 'https://schema.org/InStock',
          },
        }
      : {}),
    organizer: { '@id': `${site.url}/#organization` },
  },
];

// What this room produced in writing. Part of the event content flywheel:
// one real event should be able to become a recap, a project and a workflow,
// each with its own page and its own value.
const practice = selectors.useCasesForEvent(event.slug);
const eventGuides = selectors.guidesForEvent(event.slug);

/**
 * Home → Events → Bhopal → Claude Conversation.
 *
 * The city sits in the trail because it is a real page one level up in how
 * people actually navigate: someone reading about an event in Pune wants
 * Pune next, not the national archive.
 */
const crumbs = trail(
  { name: 'Events', href: '/events' },
  { name: selectors.cityName(event.citySlug), href: `/cities/${event.citySlug}` },
  { name: event.title, href: `/events/${event.slug}` },
);
---

<Base
  title={`${event.title} · ${selectors.cityName(event.citySlug)}`}
  seoTitle={titles.event(event.title, selectors.cityName(event.citySlug))}
  description={metaDescription}
  active="/events"
  breadcrumbs={crumbs}
  schema={schema}
  image={shareImage}
  ogImageAlt={`Poster for ${event.title} in ${selectors.cityName(event.citySlug)}`}
>
  <PageIntro
    eyebrow={`${selectors.cityName(event.citySlug)} · ${formatName(event.format)}${event.volume ? ` · vol. ${String(event.volume).padStart(2, '0')}` : ''}`}
    title={event.title}
    stamp={city ? formatCoords(city.lat, city.lon) : undefined}
  >
    <p>{event.description ?? event.summary}</p>
    
    <div class="intro-facts">
      <p>
        <strong>Date:</strong> <time datetime={isoDateTime(event.date, event.startTime)}>{formatDate(event.date)}</time>
        {event.rescheduledFrom && <span class="rescheduled"> · rescheduled from {formatDateLong(event.rescheduledFrom).replace(/ \d{4}$/, '')}</span>}
      </p>
      <p><strong>Location:</strong> <a href={`/cities/${event.citySlug}`}>{selectors.cityName(event.citySlug)}</a></p>
      {ambassador && (
        <p><strong>Host:</strong> <a href={`/builders/${ambassador.builderSlug ?? ambassador.slug}`}>{ambassador.name}</a></p>
      )}
    </div>
  </PageIntro>

  <Section id="detail" tone="sunk" labelledby="detail-heading">
    <h2 id="detail-heading" class="visually-hidden">Details</h2>
    <div class:list={['detail', { 'has-aside': hasAside }]}>
      <div class="detail-main">
        <div 
          class="detail-status" 
          data-event-end={
            event.endTime 
              ? isoDateTime(event.date, event.endTime) 
              : new Date(istInstant(event.date, event.startTime).getTime() + 2 * 3600000).toISOString()
          }
        >
          <span class:list={['pip', `pip-${lifecycleTone(lifecycle)}`]}>
            {lifecycleLabel(lifecycle)}
          </span>
          <span class="detail-when">{relativeDay(event.date)}</span>
        </div>

        <p class="detail-date">
          <time datetime={isoDateTime(event.date, event.startTime)}>{formatDate(event.date)}</time>
        </p>
        <p class="detail-time">{formatTimeRange(event.startTime, event.endTime)}</p>
        {
          event.rescheduledFrom && (
            <p class="detail-rescheduled">
              {lifecycle === 'cancelled'
                ? `Moved to ${formatDateLong(event.date)} from ${formatDateLong(event.rescheduledFrom).replace(/ \d{4}$/, '')}.`
                : `${isPast ? 'Held on' : 'Now on'} ${formatDateLong(event.date)}, rescheduled from ${formatDateLong(event.rescheduledFrom).replace(/ \d{4}$/, '')}.`}
            </p>
          )
        }

        {
          ambassador && (
            <div class="detail-host">
              <span class="chip chip-verified">Ambassador-led</span>
              <p class="detail-host-line">
                {/*
                  §29 — the host credit leads to the AMBASSADOR page, not
                  straight to the builder profile.
                
                  It used to link to `/builders/…`, which skipped the one page
                  that answers the question a reader of an event page actually
                  has: what else does this person run. The ambassador page
                  carries the upcoming and past rooms and cross-links the
                  builder profile from there (§24), so nothing is lost and the
                  graph runs the way §29 and §30 describe.
                */}
                Hosted by{' '}
                <a href={`/ambassadors/${ambassador.slug}`}>{ambassador.name}</a>, {ambassador.title}.
              </p>

              {/*
                Everyone else credited on this room, if anyone is. Reads
                `event_hosts` through the selector, so a co-host or organiser
                credit added in the admin appears here without this page
                learning anything new about roles.
              */}
              {otherCredits.length > 0 && (
                <p class="detail-host-line">
                  With{' '}
                  {otherCredits.map((entry, index) => (
                    <>
                      {index > 0 && (index === otherCredits.length - 1 ? ' & ' : ', ')}
                      <a href={`/ambassadors/${entry.ambassador.slug}`}>{entry.ambassador.name}</a>
                      {` (${CREDIT_ROLE_LABEL[entry.credit.role]})`}
                    </>
                  ))}
                  .
                </p>
              )}
              <p class="detail-host-note">
                Claude Community Ambassadors are appointed by Anthropic. This site records the
                status, it does not grant it.
              </p>
            </div>
          )
        }

        <dl class="detail-meta">
          <div>
            <dt class="label">Venue</dt>
            <dd>
              {event.venue.name}
              {event.venue.address && <span class="detail-sub">{event.venue.address}</span>}
              {
                event.venue.private && (
                  <span class="detail-sub">Shared with confirmed registrants</span>
                )
              }
            </dd>
          </div>
          <div>
            <dt class="label">City</dt>
            <dd><a href={`/cities/${event.citySlug}`}>{selectors.cityName(event.citySlug)}</a></dd>
          </div>
          <div>
            <dt class="label">Entry</dt>
            <dd>{event.free ? 'Free · approval required' : 'Ticketed'}</dd>
          </div>
          {
            coHosts.length > 0 && (
              <div>
                <dt class="label">Co-hosted by</dt>
                <dd>
                  {coHosts.map((person, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={`/builders/${person.slug}`}>{person.name}</a>
                    </>
                  ))}
                </dd>
              </div>
            )
          }
          {
            event.host.organisations && event.host.organisations.length > 0 && (
              <div>
                <dt class="label">With</dt>
                <dd>{event.host.organisations.join(', ')}</dd>
              </div>
            )
          }
        </dl>

        {
          event.agenda && event.agenda.length > 0 && (
            <div class="detail-block">
              <h3 class="label detail-block-head">What happens</h3>
              <ol class="detail-agenda">
                {event.agenda.map((item) => (
                  <li>
                    {item.time && <span class="agenda-time">{formatTime(item.time)}</span>}
                    <span class="agenda-title">{item.title}</span>
                    {item.detail && <span class="detail-sub">{item.detail}</span>}
                  </li>
                ))}
              </ol>
            </div>
          )
        }

        {
          speakers.length > 0 && (
            <div class="detail-block">
              <h3 class="label detail-block-head">Led by</h3>
              <ul class="detail-people">
                {speakers.map((person) => (
                  <li>
                    <a href={`/builders/${person.slug}`}>{person.name}</a>
                    <span class="detail-sub">{person.role}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          event.outcomes && (
            <div class="detail-block">
              <h3 class="label detail-block-head">What happened</h3>
              <ul class="detail-outcomes">
                {event.outcomes.map((outcome) => (
                  <li>{outcome}</li>
                ))}
              </ul>
            </div>
          )
        }


        {
          recaps.length > 0 && (
            <div class="detail-block">
              <h3 class="label detail-block-head">Written up</h3>
              <ul class="detail-people">
                {recaps.map((story) => (
                  <li>
                    <a href={`/stories/${story.slug}`}>{story.title}</a>
                    <span class="detail-sub">{story.standfirst}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          (practice.length > 0 || eventGuides.length > 0) && (
            <div class="detail-block">
              <h3 class="label detail-block-head">Practice from this room</h3>
              <ul class="detail-people">
                {practice.map((useCase) => (
                  <li>
                    <a href={`/use-cases/${useCase.slug}`}>{useCase.title}</a>
                    <span class="detail-sub">{useCase.summary}</span>
                  </li>
                ))}
                {eventGuides.map((guide) => (
                  <li>
                    <a href={`/guides/${guide.slug}`}>{guide.title}</a>
                    <span class="detail-sub">{guide.standfirst}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          isPast && outputs.length === 0 && !projectsFailed && (
            <div class="detail-block detail-open">
              <h3 class="label detail-block-head">Build something here?</h3>
              <p class="detail-open-copy">
                Nothing from this room is in the archive yet. If you made something, it belongs on
                the record.
              </p>
              <a class="link-arrow" href="/submit/">
                <span>Submit your build</span>
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </div>
          )
        }

        <div class="detail-actions">
          {
            canRegister && registerHref ? (
              <a class="btn btn-clay" href={registerHref} target="_blank" rel="noopener">
                <span>Register</span>
                <span class="arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            ) : (
              <span class="btn btn-quiet" aria-disabled="true">
                {lifecycleLabel(lifecycle)}
              </span>
            )
          }
          <a class="link-arrow" href="/events">
            <span>All events</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      {
        hasAside && (
          <aside class="detail-aside">
            {cover && (
              <figure class="detail-cover">
                <div class="plate plate-framed">
                  <Image
                    src={cover}
                    alt={`Poster for ${event.title} in ${selectors.cityName(event.citySlug)}`}
                    widths={[360, 640]}
                    sizes="(max-width: 61.99em) 90vw, 340px"
                    loading="eager"
                    decoding="async"
                  />
                </div>
                <figcaption class="plate-caption">
                  <span>{`vol. ${String(event.volume ?? 0).padStart(2, '0')}`}</span>
                  <span>{`${parts.monthShort} ${parts.year}`}</span>
                </figcaption>
              </figure>
            )}

            {event.photos && event.photos.length > 0 && (
              <div class="detail-photos">
                <h3 class="label detail-block-head">From the room</h3>
                <ul>
                  {event.photos.map((photo, i) => (
                    <li>
                      <figure>
                        <div class="plate plate-framed plate-zoom">
                          <Image
                            src={requireAsset(photo.src)}
                            alt={photo.alt}
                            widths={[400, 700]}
                            sizes="(max-width: 61.99em) 90vw, 340px"
                            loading="lazy"
                            decoding="async"
                          />
                        </div>
                        <figcaption class="plate-caption">
                          <span>
                            {`Pl. ${String(event.volume ?? 0).padStart(2, '0')}/${String(i + 1).padStart(2, '0')}`}
                          </span>
                        </figcaption>
                      </figure>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </aside>
        )
      }
    </div>
  </Section>

  {
    built.total > 0 && (
      <Section id="projects" labelledby="projects-heading">
        <div class="dir event-projects">
          <div class="event-projects-head">
            <h2 id="projects-heading">
              Projects built here <span class="event-projects-count">{built.total}</span>
            </h2>
            <a class="dir-clear" href={directoryHref({ events: [event.slug] })}>
              {built.total > outputs.length ? `See all ${built.total} in the Project Directory →` : 'Open in the Project Directory →'}
            </a>
          </div>
          <ul class="dir-list">
            {outputs.map((project) => (
              <li>
                <ProjectRow project={project} />
              </li>
            ))}
          </ul>
        </div>
      </Section>
    )
  }

  {
    projectsFailed && (
      <Section id="projects" labelledby="projects-heading">
        <div class="dir event-projects">
          <h2 id="projects-heading">Projects built here</h2>
          <p class="dir-status" data-state="error" role="status">
            The projects from this event could not be loaded right now.{' '}
            <a href={directoryHref({ events: [event.slug] })}>Try the Project Directory</a>
          </p>
        </div>
      </Section>
    )
  }

  <Section id="around" size="sm">
    <nav class="around" aria-label="Other events">
      {
        previous ? (
          <a class="around-link" href={`/events/${previous.slug}`}>
            <span class="around-dir">← Before</span>
            <span class="around-title">{previous.title}</span>
            <span class="around-meta">{formatDate(previous.date)}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        upNext && (
          <a class="around-link is-next" href={`/events/${upNext.slug}`}>
            <span class="around-dir">After →</span>
            <span class="around-title">{upNext.title}</span>
            <span class="around-meta">{formatDate(upNext.date)}</span>
          </a>
        )
      }
    </nav>
  </Section>

  <script>
    // Progressive enhancement to handle stale CDN cache between event end and nightly cron
    const statusEl = document.querySelector('.detail-status[data-event-end]');
    const actionsEl = document.querySelector('.detail-actions');
    
    if (statusEl) {
      const endStr = statusEl.getAttribute('data-event-end');
      if (endStr && Date.now() >= new Date(endStr).getTime()) {
        const pip = statusEl.querySelector('.pip');
        if (pip && !pip.classList.contains('pip-archive')) {
          pip.className = 'pip pip-archive';
          pip.textContent = 'Past';
          
          if (actionsEl) {
            const btn = actionsEl.querySelector('.btn');
            if (btn && btn.tagName === 'A') {
              const span = document.createElement('span');
              span.className = 'btn btn-quiet';
              span.setAttribute('aria-disabled', 'true');
              span.textContent = 'Past';
              btn.replaceWith(span);
            }
          }
        }
      }
    }
  </script>
</Base>

<style>
  .event-projects {
    display: grid;
    gap: 1rem;
    padding-inline: 0;
  }

  .event-projects-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }

  .event-projects-head h2 {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.375rem;
    font-weight: 650;
  }

  .event-projects-count {
    margin-left: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    vertical-align: middle;
  }

  .detail-rescheduled,
  .rescheduled {
    color: var(--ink-3);
  }

  .detail-rescheduled {
    margin: 0;
    font-size: var(--t-small);
  }
  .intro-facts {
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: var(--border-hair) solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .intro-facts p + p {
    margin-top: var(--s-2);
  }

  .intro-facts a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .detail {
    display: grid;
    gap: var(--s-8);
  }

  .detail-status {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    padding-bottom: var(--s-4);
    border-bottom: var(--border-heavy) solid var(--ink);
  }

  .detail-when {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .detail-date {
    margin-top: var(--s-6);
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4.5vw, 3rem);
    font-weight: 300;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .detail-time {
    margin-top: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-small);
    letter-spacing: 0.05em;
